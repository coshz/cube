{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "#internal/*": ["./dist/internal/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
