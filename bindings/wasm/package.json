{
    "name": "@coshz/jscube",
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "type": "module",
    "version": "0.6.1",
    "description": "A WASM-based Rubik's Cube library",
    "keywords": [
        "rubiks-cube-solver",
        "binding",
        "wasm"
    ],
    "bugs": {
        "url": "https://github.com/coshz/cube/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/coshz/cube.git"
    },
    "license": "MIT",
    "author": "coshz <fsinhx@gmail.com>",
    "main": "./dist/index.node.mjs",
    "module": "./dist/index.web.mjs",
    "types": "./dist/index.node.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "node": {
                "types": "./dist/index.node.d.mts",
                "default": "./dist/index.node.mjs"
            },
            "browser": {
                "types": "./dist/index.web.d.mts",
                "default": "./dist/index.web.mjs"
            },
            "default": {
                "types": "./dist/index.web.d.mts",
                "default": "./dist/index.web.mjs"
            }
        }
    },
    "imports": {
        "#internal/*": "./dist/internal/*"
    },
    "files": ["dist"],
    "scripts": {
        "build:wasm": "rimraf dist/internal && make -f ../../dev/gen_wasm.mk",
        "build:ts": "tsc --build --force",
        "build:clean": "rimraf --glob \"dist/!(internal)\" tsconfig.tsbuildinfo",
        "build": "npm run build:clean && npm run build:wasm && npm run build:ts",
        "clean": "rimraf dist tsconfig.tsbuildinfo",
        "watch": "tsc --watch",
        "demo:node": "tsx examples/demo-node/main.mts",
        "demo:web": "vite examples/demo-web --open"
    },
    "devDependencies": {
        "@types/node": "^25.9.7",
        "rimraf": "^6.1.4",
        "typescript": "^5.9.3",
        "vite": "^8.3.6"
    }
}
