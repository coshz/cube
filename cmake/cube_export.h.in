#pragma once

#ifndef CUBE_INSIDE_GUARD 
  #warning "Do not include this file directly!"
#endif 

#cmakedefine01 CUBE_STATIC_DEFINE // 0: shared lib, 1: static lib

#if defined(_WIN32) || defined(__CYGWIN__)
  #if defined(CUBE_STATIC_DEFINE)
    #define CUBE_API
  #elif defined(CUBE_BUILD)
    #define CUBE_API __declspec(dllexport)
  #else
    #define CUBE_API __declspec(dllimport)
  #endif
#else
  #if defined(__GNUC__) && __GNUC__ >= 4
    #define CUBE_API __attribute__((visibility("default")))
  #else
    #define CUBE_API
  #endif
#endif