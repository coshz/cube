@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/CubeTargets.cmake")
include(CMakeFindDependencyMacro)

if(TARGET Cube::cube_shared)
    add_library(Cube::shared ALIAS Cube::cube_shared)
endif()

if(TARGET Cube::cube_static)
    add_library(Cube::static ALIAS Cube::cube_static)
endif()

check_required_components(cube)