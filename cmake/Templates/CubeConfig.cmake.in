@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/CubeTargets.cmake")

if(TARGET Cube::shared)
    set(Cube_shared_FOUND TRUE)
else()
    set(Cube_shared_FOUND FALSE)
endif()
if(TARGET Cube::static)
    set(Cube_static_FOUND TRUE)
else()
    set(Cube_static_FOUND FALSE)
endif()

check_required_components(Cube)