prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: cube
Description: Cube C++ library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lcube
# Lib.private: @CUBE_PKGCONFIG_LIBS_PRIVATE@ 
Cflags: -I${includedir}
Cflags.private: -DCUBE_STATIC_DEFINE
